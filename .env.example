# ─── Application ────────────────────────────────────────────────────────────────
# Node environment: development | test | production
NODE_ENV=development

# Port the Express server listens on
PORT=3000

# ─── Database (PostgreSQL via Knex) ─────────────────────────────────────────────
# Hostname of the PostgreSQL server
DB_HOST=127.0.0.1

# PostgreSQL port
DB_PORT=5432

# Database name for development
DB_NAME=ecommerce_dev

# Database name for test runs
DB_NAME_TEST=ecommerce_test

# PostgreSQL user
DB_USER=postgres

# PostgreSQL password
DB_PASSWORD=postgres

# ─── JSON Web Tokens ────────────────────────────────────────────────────────────
# Secret key used to sign JWTs (use a long, random string in production)
JWT_SECRET=change_me_to_a_long_random_string

# JWT expiry duration (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Secret for refresh tokens
JWT_REFRESH_SECRET=change_me_to_another_long_random_string

# Refresh token expiry duration
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ─────────────────────────────────────────────────────────────────────
# Number of salt rounds for bcrypt hashing
BCRYPT_SALT_ROUNDS=12

# ─── Elasticsearch ──────────────────────────────────────────────────────────────
# URL of the Elasticsearch cluster
ELASTICSEARCH_URL=http://localhost:9200

# Name of the Elasticsearch index used for product search
ELASTICSEARCH_INDEX=products

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window per IP
RATE_LIMIT_MAX=100

# ─── Logging ────────────────────────────────────────────────────────────────────
# Logging level: error | warn | info | http | debug
LOG_LEVEL=info

# Directory where log files are written
LOG_DIR=logs

# ─── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (use * to allow all in development)
CORS_ALLOWED_ORIGINS=http://localhost:3001
